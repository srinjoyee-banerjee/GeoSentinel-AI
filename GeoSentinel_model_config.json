    },
    "output": {
        "shape": [
            256,
            256,
            1
        ],
        "type": "pixel-wise change probability",
        "activation": "sigmoid"
    },
    "parameters": 1955393,
    "threshold": 0.6,
    "validation_scenes": 12,
    "failure_definition": "Dice < 0.30",
    "failure_scenes": [
        1,
        3,
        6,
        9,
        10
    ],
    "good_scenes": [
        0,
        2,
        8,
        11
